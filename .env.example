# ===========================================
# StudyPlot — Environment Variables
# ===========================================
# Copy this file to client/.env and server/.env
# and fill in the values described below.

# ----------- Client (client/.env) -----------
# Base URL the frontend uses to reach the backend API
VITE_API_URL=http://localhost:5000/api

# ----------- Server (server/.env) -----------
# Port the Express server listens on
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=

# URL of the deployed/local frontend, used for CORS
CLIENT_URL=http://localhost:5173

# Gemini API key (used in a future phase for AI features)
GEMINI_API_KEY=
